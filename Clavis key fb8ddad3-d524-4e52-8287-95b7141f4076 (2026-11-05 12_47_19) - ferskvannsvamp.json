  "characters": [
    {
      "id": "character:a6dd86e0b9be436482613cd94070f1fc",
      "title": {
        "nb": "Ynglekorn"
      },
      "states": [
        {
          "id": "state:3a187eb74dc24d28b9775e50863a32e5",
          "title": {
            "nb": "Ynglekorn danner en sammenhengende skorpe. Glatte store nåler (megasclerer) ingen spisse smånåler, men ynglekornene (gemmulae) inneholder butte, piggete nåler."
          }
        },
        {
          "id": "state:dbe0a68129454645b8aaeed05e084e82",
          "title": {
            "nb": "Ynglekorn spredd i svampvevet"
          }
        }
      ]
    },
    {
