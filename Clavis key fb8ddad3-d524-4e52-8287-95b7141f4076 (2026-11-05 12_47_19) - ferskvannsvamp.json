          "title": {
            "nb": "Bare en type trådsneller (amfidisker)"
          }
        }
      ]
    },
    {
      "id": "character:c6ed89ea39d948609c26acc89938d6e1",
      "title": {
        "nb": "Trådsneller (amfidisker) lengde"
      },
      "states": [
        {
          "id": "state:142f9f5ebfc244b4bd70d4efde4fcc56",
          "title": {
            "nb": "Korte trådsneller (amfidisker) akselen ikke lenger enn diameteren på hjulet.  Nåler med mer eller mindre tydelige torner."
          },
          "media": "media:f21705"
        },
        {
          "id": "state:2ece9029d8704ef39ab0424739daba8e",
          "title": {
            "nb": "Lange trådsneller (amfidisker) akselen lenger enn diameteren på hjulet. Nåler glatte"
          },
          "media": "media:f21706"
        }
      ]
    }
